<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <io.legado.app.lib.prefs.PreferenceCategory
        android:title="@string/web_service"
        app:allowDividerAbove="false"
        app:allowDividerBelow="false"
        app:iconSpaceReserved="false"
        app:layout="@layout/view_preference_category">

        <io.legado.app.lib.prefs.Preference
            android:key="webPort"
            android:title="@string/web_port_title"
            app:iconSpaceReserved="false" />

        <io.legado.app.lib.prefs.Preference
            android:key="webServiceToken"
            android:summary="@string/web_service_token_summary"
            android:title="@string/web_service_token_title"
            app:iconSpaceReserved="false" />

        <io.legado.app.lib.prefs.SwitchPreference
            android:defaultValue="false"
            android:key="webServiceAuthEnabled"
            android:summary="@string/web_service_auth_summary"
            android:title="@string/web_service_auth_title"
            app:iconSpaceReserved="false" />

        <io.legado.app.lib.prefs.SwitchPreference
            android:defaultValue="false"
            android:key="webServiceWakeLock"
            android:summary="@string/web_service_wake_lock_summary"
            android:title="@string/web_service_wake_lock"
            app:iconSpaceReserved="false" />

    </io.legado.app.lib.prefs.PreferenceCategory>

</androidx.preference.PreferenceScreen>